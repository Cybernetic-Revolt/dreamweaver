# Dreamweaver Environment Configuration
# Copy to .env and fill in values

# LiveKit credentials (generate with: make keys)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_min_32_characters_long_here

# LiveKit URLs (TWO REQUIRED)
# Internal: for containers talking to each other (docker network)
LIVEKIT_WS_URL_INTERNAL=ws://livekit:7880
# External: for host machine and mobile devices
LIVEKIT_WS_URL_EXTERNAL=ws://localhost:7880

# Redis
REDIS_URL=redis://localhost:6379

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Whisper STT
WHISPER_MODEL=small.en

# Server
PORT=3000
DATABASE_PATH=./data/dreamweaver.db

# Optional: ElevenLabs TTS fallback
# ELEVENLABS_API_KEY=your_key_here
